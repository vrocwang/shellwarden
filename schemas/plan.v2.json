{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shellwarden.local/schemas/plan.v2.json",
  "title": "ShellWarden Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "task_id", "version", "host_id", "identity_id", "steps", "execution_context"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "plan_id": { "type": "string", "pattern": "^plan_" },
    "task_id": { "type": "string", "pattern": "^task_" },
    "version": { "type": "integer", "minimum": 1 },
    "host_id": { "type": "string" },
    "identity_id": { "type": "string" },
    "request": { "type": "string" },
    "summary": { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": { "$ref": "#/$defs/step" }
    },
    "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "execution_context": { "$ref": "execution-context.v1.json" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": { "type": "integer", "minimum": 1, "maximum": 30 },
        "total_timeout_seconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "tool", "arguments"],
      "properties": {
        "step_id": { "type": "string", "minLength": 1 },
        "tool": { "type": "string", "minLength": 1 },
        "arguments": { "type": "object" },
        "argument_provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(user_input|user_selected|host_probe|model_literal|unknown|tool_output:[^:]+|knowledge:[^:]+)$"
          }
        },
        "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "timeout_seconds": { "type": "integer", "minimum": 1 },
        "output_limit_bytes": { "type": "integer", "minimum": 1 },
        "preconditions": { "type": "array", "items": { "$ref": "#/$defs/precondition" } },
        "verification": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
        "reversible": { "enum": ["yes", "no", "unknown"] },
        "risk_hint": { "enum": ["R0", "R1", "R2", "R3", "R4"] }
      }
    },
    "precondition": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["file_hash", "path_exists", "path_absent", "service_state", "package_version", "process_absent", "custom"]
        },
        "path": { "type": "string" },
        "algorithm": { "type": "string" },
        "expected": { "type": "string" },
        "name": { "type": "string" },
        "op": { "type": "string" },
        "version": { "type": "string" },
        "pattern": { "type": "string" },
        "tool": { "type": "string" },
        "arguments": { "type": "object" },
        "expected_pattern": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["exit_code_is", "assert_output_matches", "assert_output_not_matches", "file_hash_equals", "file_contains", "service_state_is", "process_running", "process_absent", "json_field_equals", "assert_text_contains"]
        },
        "expected": {},
        "pattern": { "type": "string" },
        "min_count": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "algorithm": { "type": "string" },
        "name": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "on_fail": { "enum": ["fail", "inform"] }
      }
    }
  }
}
